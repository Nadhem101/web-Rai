# ── Local development (choose one block) ──────────────────────

# Option A — individual vars (local PostgreSQL)
DB_NAME=web_rai
DB_USER=webrai_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Option B — full connection string (Supabase / cloud)
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Server ─────────────────────────────────────────────────────
PORT=3001

# ── CORS — set to your Vercel frontend URL in production ───────
# FRONTEND_URL=https://web-rai.vercel.app
